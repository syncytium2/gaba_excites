{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/send-goes-nowhere.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/adr/adr.py\"; [ -f \"$f\" ] && exec python3 \"$f\" hook || exit 0"
          }
        ]
      }
    ]
  }
}
